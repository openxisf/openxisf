@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Only a static library needs its private dependencies at link time.
if(NOT @OPENXISF_SHARED@)
    # lz4 and zstd come with find modules, because many distributions ship only pkg-config files.
    list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}/modules")
    find_dependency(pugixml CONFIG)
    find_dependency(ZLIB)
    find_dependency(lz4)
    find_dependency(zstd)
    if(@OPENXISF_WITH_TBB@)
        find_dependency(TBB CONFIG)
    endif()
    if(@OPENXISF_WITH_OPENSSL@)
        find_dependency(OpenSSL)
    endif()
    list(POP_FRONT CMAKE_MODULE_PATH)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/openxisf-targets.cmake")

check_required_components(openxisf)
